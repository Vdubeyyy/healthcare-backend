# Healthcare Management Backend Environment Configuration

# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# Database Dialect: 'postgres' or 'sqlite'
# If PostgreSQL is running on your machine or cloud provider, set DB_DIALECT=postgres
DB_DIALECT=sqlite

# PostgreSQL Connection Settings (when DB_DIALECT=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcare_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SSL=false

# Alternatively, specify a single PostgreSQL connection URI:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/healthcare_db

# JWT Configuration
JWT_SECRET=super_secret_healthcare_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=24h
