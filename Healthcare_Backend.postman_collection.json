{
  "info": {
    "_postman_id": "a8f3b4c1-6e92-48a0-9c1b-29a531e21b01",
    "name": "Healthcare Backend System API",
    "description": "Postman Collection for testing all Authentication, Patient, Doctor, and Mapping APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Watson\",\n  \"email\": \"watson@healthcare.com\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register", ""]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"watson@healthcare.com\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login", ""]
            }
          }
        }
      ]
    },
    {
      "name": "2. Patient Management",
      "item": [
        {
          "name": "Add Patient (POST /api/patients/)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Cooper\",\n  \"age\": 34,\n  \"gender\": \"Female\",\n  \"contact\": \"+1-555-0101\",\n  \"address\": \"456 Elm St\",\n  \"medical_history\": \"Seasonal allergies\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/patients/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", ""]
            }
          }
        },
        {
          "name": "Retrieve User Patients (GET /api/patients/)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/patients/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", ""]
            }
          }
        },
        {
          "name": "Get Specific Patient (GET /api/patients/<id>/)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/patients/1/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", "1", ""]
            }
          }
        },
        {
          "name": "Update Patient (PUT /api/patients/<id>/)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Cooper Updated\",\n  \"age\": 35,\n  \"gender\": \"Female\",\n  \"contact\": \"+1-555-0999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/patients/1/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", "1", ""]
            }
          }
        },
        {
          "name": "Delete Patient (DELETE /api/patients/<id>/)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/patients/1/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", "1", ""]
            }
          }
        }
      ]
    },
